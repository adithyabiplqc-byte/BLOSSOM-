rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // System configurations: read and write by anyone to ensure permanent storage of GAS configs & maintenance
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Online users presence tracking across all client devices & Netlify
    match /presence/{userId} {
      allow read, write: if true;
    }
  }
}
