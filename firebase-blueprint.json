{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user profile and permissions",
      "type": "object",
      "properties": {
        "userCode": { "type": "string", "description": "Unique user code" },
        "username": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "enum": ["ADMIN", "USER", "WORKORDER"], "description": "User role" },
        "location": { "type": "string", "description": "Assigned zone or location" },
        "restrictions": { "type": "array", "items": { "type": "string" }, "description": "List of restricted module IDs" },
        "email": { "type": "string", "format": "email", "description": "User email from auth" }
      },
      "required": ["userCode", "username", "role", "location"]
    },
    "Workorder": {
      "title": "Workorder",
      "description": "Production workorder details",
      "type": "object",
      "properties": {
        "workorderNumber": { "type": "string", "description": "Unique WO number" },
        "zone": { "type": "string", "description": "Assigned zone" },
        "item": { "type": "string", "description": "Item name" },
        "style": { "type": "string", "description": "Style name" },
        "sizeRange": { "type": "string", "description": "Size range" },
        "quantity": { "type": "number", "description": "Total quantity" },
        "colour": { "type": "string", "description": "Item color" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["workorderNumber", "zone", "item", "style", "quantity"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global or user-specific dropdown configuration",
      "type": "object",
      "properties": {
        "ZONE": { "type": "array", "items": { "type": "string" } },
        "UNITS": { "type": "array", "items": { "type": "string" } },
        "SUPPLIER": { "type": "array", "items": { "type": "string" } },
        "ITEMS": { "type": "array", "items": { "type": "string" } },
        "COLORS": { "type": "array", "items": { "type": "string" } },
        "SIZES": { "type": "array", "items": { "type": "string" } },
        "DEFECTS": { "type": "array", "items": { "type": "string" } },
        "OPERATIONS": { "type": "array", "items": { "type": "string" } },
        "MACHINE": { "type": "array", "items": { "type": "string" } },
        "WORKERS": { "type": "array", "items": { "type": "string" } },
        "CUPSIZE": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MaterialReport": {
      "title": "Material Report",
      "description": "Material inspection record",
      "type": "object",
      "properties": {
        "supplier": { "type": "string" },
        "item": { "type": "string" },
        "color": { "type": "string" },
        "size": { "type": "string" },
        "rollNo": { "type": "string" },
        "totalPoints": { "type": "number" },
        "width": { "type": "number" },
        "length": { "type": "number" },
        "status": { "type": "string" },
        "remarks": { "type": "string" },
        "inspector": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Card": {
      "title": "Traceability Card",
      "description": "PVC Card management for production traceability",
      "type": "object",
      "properties": {
        "cardNumber": { "type": "string", "description": "Unique PVC card ID" },
        "workorderNumber": { "type": "string", "description": "Active workorder assigned to card" },
        "currentStatus": { "type": "string", "enum": ["IDLE", "MATERIAL", "CUTTING", "INLINE", "ENDLINE", "AQL", "FINAL"], "description": "Current workflow stage" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cardNumber"]
    },
    "MaterialTraceability": {
      "title": "Material Traceability",
      "description": "Linking material details to a traceability card",
      "type": "object",
      "properties": {
        "cardNumber": { "type": "string" },
        "workorderNumber": { "type": "string" },
        "itemName": { "type": "string" },
        "billNumber": { "type": "string" },
        "remarks": { "type": "string" },
        "status": { "type": "string" },
        "inspector": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/workorders/{woId}": {
      "schema": "Workorder",
      "description": "Production workorders"
    },
    "/cards/{cardId}": {
      "schema": "Card",
      "description": "Traceability cards"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global and user settings"
    },
    "/reports/Material/{reportId}": {
      "schema": "MaterialReport",
      "description": "Material inspection reports"
    },
    "/reports/MaterialTraceability/{reportId}": {
      "schema": "MaterialTraceability",
      "description": "Material traceability records"
    },
    "/reports/Cutting/{reportId}": {
      "schema": "object",
      "description": "Cutting quality reports"
    },
    "/reports/Inline/{reportId}": {
      "schema": "object",
      "description": "Inline quality reports"
    },
    "/reports/Endline/{reportId}": {
      "schema": "object",
      "description": "Endline quality reports"
    },
    "/reports/AQL/{reportId}": {
      "schema": "object",
      "description": "AQL inspection reports"
    },
    "/reports/FinalAudit/{reportId}": {
      "schema": "object",
      "description": "Final audit reports"
    }
  }
}
